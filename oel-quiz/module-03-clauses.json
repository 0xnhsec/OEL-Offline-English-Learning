  "questions": [
    {
      "id": 1,
      "topic": "Clauses",
      "difficulty": "easy",
      "question": "A clause must contain ___.",
      "options": {
        "A": "a noun and an adjective",
        "B": "a preposition and a noun",
        "C": "an adverb and a verb",
        "D": "a subject and a finite verb"
      },
      "answer": "D",
      "trap": "Frasa juga bisa panjang.",
      "explanation": "Klausa = SUBJECT + PREDICATE dengan finite verb."
    },
    {
      "id": 2,
      "topic": "Clauses",
      "difficulty": "easy",
      "question": "Which is an independent clause?",
      "options": {
        "A": "When the scan",
        "B": "Because the scan finished.",
        "C": "The scan finished.",
        "D": "After the scan."
      },
      "answer": "C",
      "trap": "Semua mengandung 'the scan'.",
      "explanation": "Hanya yang pikirannya lengkap dan bisa berdiri sendiri."
    },
    {
      "id": 3,
      "topic": "Clauses",
      "difficulty": "easy",
      "question": "Which is a dependent clause?",
      "options": {
        "A": "She went home.",
        "B": "She was tired.",
        "C": "Although she was tired",
        "D": "She slept early."
      },
      "answer": "C",
      "trap": "Semua punya subjek dan verb.",
      "explanation": "Subordinator 'although' membuat pikirannya tak lengkap."
    },
    {
      "id": 4,
      "topic": "Clauses",
      "difficulty": "easy",
      "question": "Which word is a subordinator?",
      "options": {
        "A": "but",
        "B": "and",
        "C": "so",
        "D": "although"
      },
      "answer": "D",
      "trap": "FANBOYS dikira subordinator.",
      "explanation": "and/but/so = coordinating. 'although' = subordinating."
    },
    {
      "id": 5,
      "topic": "Clauses",
      "difficulty": "easy",
      "question": "How many clauses are in 'The server crashed, and the team restarted it.'?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "3",
        "D": "2"
      },
      "answer": "D",
      "trap": "Hanya satu subjek tersorot.",
      "explanation": "Dua subject + finite verb: server crashed, team restarted."
    },
    {
      "id": 6,
      "topic": "Clauses",
      "difficulty": "medium",
      "question": "'After the meeting' is a ___.",
      "options": {
        "A": "phrase",
        "B": "independent clause",
        "C": "compound sentence",
        "D": "dependent clause"
      },
      "answer": "A",
      "trap": "Diawali kata seperti subordinator.",
      "explanation": "Tidak ada subject + finite verb; PP biasa."
    },
    {
      "id": 7,
      "topic": "Clauses",
      "difficulty": "medium",
      "question": "'After the meeting ended' is a ___.",
      "options": {
        "A": "prepositional phrase",
        "B": "dependent clause",
        "C": "independent clause",
        "D": "noun phrase"
      },
      "answer": "B",
      "trap": "Mirip dengan soal sebelumnya.",
      "explanation": "Ada subject 'the meeting' + finite verb 'ended' + subordinator 'after'."
    },
    {
      "id": 8,
      "topic": "Clauses",
      "difficulty": "medium",
      "question": "What makes 'because the server crashed' dependent?",
      "options": {
        "A": "It has no subject",
        "B": "It is too short",
        "C": "The subordinator leaves the thought incomplete",
        "D": "It has no verb"
      },
      "answer": "C",
      "trap": "Dikira karena kurang unsur.",
      "explanation": "Subjek dan verb ada; subordinator yang membuatnya bergantung."
    },
    {
